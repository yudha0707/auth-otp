{
  "manifest_version": 3,
  "name": "OTP Authenticator",
  "version": "1.0.0",
  "description": "Lihat kode OTP (TOTP) langsung dari browser Chrome — seperti Google Authenticator",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "OTP Authenticator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ]
}
